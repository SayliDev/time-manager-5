BEGIN;

-- =====================================================
-- EXTENSIONS
-- =====================================================

CREATE EXTENSION IF NOT EXISTS pgcrypto;

-- =====================================================
-- FONCTION AUDIT
-- =====================================================

CREATE OR REPLACE FUNCTION audit_trigger_function()
RETURNS TRIGGER
LANGUAGE plpgsql
AS $$
DECLARE
    v_hash TEXT;
BEGIN

    IF TG_TABLE_NAME = 'audit_log' THEN
        RETURN COALESCE(NEW, OLD);
    END IF;

    IF TG_OP = 'INSERT' THEN

        v_hash := encode(
            digest(
                TG_TABLE_NAME ||
                TG_OP ||
                to_jsonb(NEW)::text,
                'sha256'
            ),
            'hex'
        );

        INSERT INTO audit_log (
            table_cible,
            action,
            nouvelle_valeur,
            utilisateur_session,
            empreinte
        )
        VALUES (
            TG_TABLE_NAME,
            TG_OP,
            to_jsonb(NEW),
            CURRENT_USER,
            v_hash
        )
        ON CONFLICT DO NOTHING;

        RETURN NEW;

    ELSIF TG_OP = 'UPDATE' THEN

        IF to_jsonb(OLD) = to_jsonb(NEW) THEN
            RETURN NEW;
        END IF;

        v_hash := encode(
            digest(
                TG_TABLE_NAME ||
                TG_OP ||
                to_jsonb(OLD)::text ||
                to_jsonb(NEW)::text,
                'sha256'
            ),
            'hex'
        );

        INSERT INTO audit_log (
            table_cible,
            action,
            ancienne_valeur,
            nouvelle_valeur,
            utilisateur_session,
            empreinte
        )
        VALUES (
            TG_TABLE_NAME,
            TG_OP,
            to_jsonb(OLD),
            to_jsonb(NEW),
            CURRENT_USER,
            v_hash
        )
        ON CONFLICT DO NOTHING;

        RETURN NEW;

    ELSIF TG_OP = 'DELETE' THEN

        v_hash := encode(
            digest(
                TG_TABLE_NAME ||
                TG_OP ||
                to_jsonb(OLD)::text,
                'sha256'
            ),
            'hex'
        );

        INSERT INTO audit_log (
            table_cible,
            action,
            ancienne_valeur,
            utilisateur_session,
            empreinte
        )
        VALUES (
            TG_TABLE_NAME,
            TG_OP,
            to_jsonb(OLD),
            CURRENT_USER,
            v_hash
        )
        ON CONFLICT DO NOTHING;

        RETURN OLD;

    END IF;

    RETURN NULL;

END;
$$;

-- =====================================================
-- CREATION DES TRIGGERS
-- =====================================================

DO $$
DECLARE
    t TEXT;
BEGIN

    FOREACH t IN ARRAY ARRAY[
        'utilisateur',
        'departement',
        'equipe',
        'affectation_equipe',
        'contrat',
        'horaire_contractuel',
        'session_travail',
        'correction_pointage',
        'absence',
        'demande_conge',
        'compteur_conge',
        'heure_supplementaire',
        'jour_ferie',
        'connexion_utilisateur'
    ]
    LOOP

        EXECUTE format(
            'DROP TRIGGER IF EXISTS trg_audit_%I ON %I',
            t,
            t
        );

        EXECUTE format(
            'CREATE TRIGGER trg_audit_%I
             AFTER INSERT OR UPDATE OR DELETE
             ON %I
             FOR EACH ROW
             EXECUTE FUNCTION audit_trigger_function()',
            t,
            t
        );

    END LOOP;

END $$;

COMMIT;